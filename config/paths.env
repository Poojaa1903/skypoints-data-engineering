# Folder paths for the pipeline. Change a path here, not in the code.
# Paths are relative to the project folder.
#
# Source files stay in data/. Everything the pipeline writes stays in outputs/.

# Where the source files arrive. Bronze reads this.
SOURCE_DIR=data/input

# Parent folder for the three layers.
OUTPUT_DIR=outputs

# Raw copies and the load log. Bronze writes this. Silver reads this.
BRONZE_DIR=outputs/bronze

# Quarantine and other cleaned-row output.
SILVER_DIR=outputs/silver

# Country tables, the review list, and redemptions.
GOLD_DIR=outputs/gold
