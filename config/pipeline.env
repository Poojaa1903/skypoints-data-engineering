# Pipeline settings. Change a value here, not in the code.
# Paths are relative to the project folder.
# Rates are fractions: 0.05 means 5 percent.

# Where the source files arrive. Bronze reads this.
SOURCE_DIR=data/input

# Parent folder for the three layers.
OUTPUT_DIR=outputs

# Raw copies and the load log. Bronze writes this. Silver reads this.
BRONZE_DIR=outputs/bronze

# Quarantine and the quality report.
SILVER_DIR=outputs/silver

# Country tables, the review list, and redemptions.
GOLD_DIR=outputs/gold

# First day to restore. A run fills gaps from this day through yesterday.
# Earlier files are ignored. A day that is already complete is skipped.
MONITORING_DATE=2024-01-15

# Rejected rows / all rows in one file.
# A file smaller than REJECT_MIN_ROWS warns instead of failing,
# so one bad row in the sample extract does not stop the day.
REJECT_WARN=0.02
REJECT_FAIL=0.05
REJECT_MIN_ROWS=20

# Fail when today's loaded members are less than half of the previous day.
ROW_DROP_FAIL=0.50

# Blank member id, name, country or enrollment date.
NULL_FAIL=0.01

# Country code not in the ISO list or the alias file.
UNMAPPED_FAIL=0.01

# Redemption with no matching member. Warn only; the row is kept.
ORPHAN_WARN=0.10
