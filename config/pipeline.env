# Edit this file to change paths or quality limits.
# The pipeline reloads it on every run.

# Git repository stage. Change the branch here if SHOW GIT REPOSITORIES differs.
SOURCE_STAGE=@skypoints_data_engineering/branches/dev

# Internal stage the COPY commands read.
INTERNAL_STAGE=@bronze.skypoints_stage
DATA_DIR=data
SEED_DIR=seed
CONFIG_DIR=config

# First file date. A call with no date runs from this day through yesterday.
MONITORING_DATE=2024-01-15

# Reject rate. Files smaller than REJECT_MIN_ROWS warn instead of fail.
REJECT_WARN=0.02
REJECT_FAIL=0.05
REJECT_MIN_ROWS=20

# Share of loaded rows whose country code is unknown.
UNMAPPED_FAIL=0.01

# Drop in member rows versus the previous day.
ROW_DROP_FAIL=0.50

# Share of staged rows missing a mandatory field.
NULL_FAIL=0.01
